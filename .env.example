# ==============================================================================
# Google ADK Environment Configuration Template
# Copy this file to .env and configure your secrets:
#   cp .env.example .env
# ==============================================================================

# Mode Selection:
# Set to FALSE to use Google AI Studio (100% Free Tier, no credit card required)
# Set to TRUE to use Google Cloud Vertex AI (requires GCP project and billing)
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Gemini API Key (Get a free key at https://aistudio.google.com/)
GOOGLE_API_KEY=your_free_ai_studio_api_key_here

# Default Gemini Model (gemini-2.0-flash recommended for high speed & free quota)
MODEL=gemini-2.0-flash

# Image Generation Model (for 06_a2a_protocol_agents / illustration_agent)
IMAGE_MODEL=imagen-3.0-generate-002

# Google Maps API Key (Optional: for 05_mcp_agents / google_maps_mcp_agent)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Cloud Settings (Only needed if GOOGLE_GENAI_USE_VERTEXAI=TRUE or 08_agent_engine_deployment)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here
GOOGLE_CLOUD_LOCATION=us-central1
